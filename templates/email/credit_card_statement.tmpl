<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="Content-Type" content="text/html;charset=utf-8"/>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, minimal-ui, viewport-fit=cover">
    <title>{{.Title}}</title>
</head>
<body style="margin: 0; padding: 0 10px 0 10px">
    <table width="360px" border="0" cellspacing="0" cellpadding="0" style="width: 360px; border: 0; border-collapse: collapse; margin: 10px auto 5px auto;">
        <tr>
            <td height="50" style="font-size: 20px; line-height: 50px"><strong>{{.AppName}}</strong></td>
        </tr>
        <tr>
            <td style="padding: 10px 0 10px 0; border-top: solid 1px #ccc">
                <p>{{.Salutation}}</p>
                <p>Below is the statement of your credit card <strong>{{.AccountName}}</strong> from {{.CycleStartTime}} to {{.CycleEndTime}}. All amounts are in {{.Currency}}.</p>
            </td>
        </tr>
        <tr>
            <td>
                <table width="100%" border="0" cellspacing="0" cellpadding="6" style="border: 0; border-collapse: collapse; font-size: 14px">
                    <tr>
                        <td style="background-color: #f5f5f5">Opening Balance</td>
                        <td align="right">{{.OpeningBalance}}</td>
                    </tr>
                    <tr>
                        <td>Total Inflows</td>
                        <td align="right">{{.TotalInflows}}</td>
                    </tr>
                    <tr>
                        <td style="background-color: #f5f5f5">Total Outflows</td>
                        <td align="right">{{.TotalOutflows}}</td>
                    </tr>
                    <tr>
                        <td style="background-color: #f5f5f5"><strong>Closing Balance</strong></td>
                        <td align="right"><strong>{{.ClosingBalance}}</strong></td>
                    </tr>
                </table>
            </td>
        </tr>
        <tr>
            <td style="padding-top: 10px">
                <table width="100%" border="0" cellspacing="0" cellpadding="6" style="border: 0; border-collapse: collapse; font-size: 14px">
                    <tr style="background-color: #f5f5f5">
                        <th align="left">Date</th>
                        <th align="left">Type</th>
                        <th align="left">Category or Account</th>
                        <th align="right">Amount</th>
                    </tr>
                    {{range .Transactions}}
                    <tr>
                        <td>{{.Time}}</td>
                        <td>{{.Type}}</td>
                        <td>{{.Description}}{{if .Comment}}<br><small style="color: #888">{{.Comment}}</small>{{end}}</td>
                        <td align="right">{{.Amount}}</td>
                    </tr>
                    {{else}}
                    <tr>
                        <td colspan="4" align="center" style="color: #888">No transactions in this period</td>
                    </tr>
                    {{end}}
                </table>
            </td>
        </tr>
        <tr>
            <td height="50" style="line-height: 50px; text-align: center">
                <a href="{{.AccountUrl}}" style="width: 100%; color: #fff; background-color:#c67e48; display:block">
                    <strong>View Bill</strong>
                </a>
            </td>
        </tr>
        <tr>
            <td style="padding-bottom: 20px">
                <small style="color: #888; word-break: break-all">{{.RootUrl}}</small>
            </td>
        </tr>
    </table>
</body>
</html>
