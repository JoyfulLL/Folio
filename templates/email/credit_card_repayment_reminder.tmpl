<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="Content-Type" content="text/html;charset=utf-8"/>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, minimal-ui, viewport-fit=cover">
    <title>{{.Title}}</title>
</head>
<body style="margin: 0; padding: 0 10px 0 10px">
    <table width="360px" border="0" cellspacing="0" cellpadding="0" style="width: 360px; border: 0; border-collapse: collapse; margin: 10px auto 5px auto;">
        <tr>
            <td height="50" style="font-size: 20px; line-height: 50px"><strong>{{.AppName}}</strong></td>
        </tr>
        <tr>
            <td style="padding: 10px 0 10px 0; border-top: solid 1px #ccc">
                <p>{{.Salutation}}</p>
                {{if eq .DaysBefore 0}}
                <p>The final repayment date of your credit card <strong>{{.AccountName}}</strong> is today ({{.RepaymentDate}}).</p>
                {{else}}
                <p>The final repayment date of your credit card <strong>{{.AccountName}}</strong> is in {{.DaysBefore}} day{{if gt .DaysBefore 1}}s{{end}} (on {{.RepaymentDate}}).</p>
                {{end}}
            </td>
        </tr>
        <tr>
            <td height="50" style="line-height: 50px; text-align: center">
                <a href="{{.AccountUrl}}" style="width: 100%; color: #fff; background-color:#c67e48; display:block">
                    <strong>View Bill</strong>
                </a>
            </td>
        </tr>
        <tr>
            <td style="padding-bottom: 20px">
                <small style="color: #888; word-break: break-all">{{.RootUrl}}</small>
            </td>
        </tr>
    </table>
</body>
</html>
