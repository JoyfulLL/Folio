[Unit]
Description=Folio is a lightweight, self-hosted personal finance app.
After=syslog.target
After=network.target
After=mariadb.service mysqld.service postgresql.service

[Service]
Type=simple
User=folio
Group=folio
WorkingDirectory=/usr/local/bin/folio
ExecStart=/usr/local/bin/folio/folio server run
Restart=on-failure

[Install]
WantedBy=multi-user.target
