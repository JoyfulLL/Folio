# /etc/folio-update.env - config for folio-update.sh
# Install:  sudo install -m 0600 deploy/folio-update.env.example /etc/folio-update.env
# Owner:    root:root, mode 0600 (GITHUB_TOKEN is a secret).
# Requires curl, tar, find, awk, python3 (or jq), systemctl.
# Oracle Linux 10 ships python3 by default; if missing: sudo dnf install -y python3

GITHUB_REPO="JoyfulLL/Folio"

# Leave empty for a public repository. For a private repository use a PAT with
# "repo" scope. Never put this token in the repository or in the systemd unit.
GITHUB_TOKEN=""

# Empty (or "latest") = newest Release; or pin e.g. "1.0.3".
RELEASE_TAG=""

# ---- your existing layout, DO NOT change these paths ----------------------
INSTALL_DIR="/opt/folio"
BACKUP_DIR="/opt/folio-backups"
# Empty = $INSTALL_DIR/conf/folio.ini (the REAL config, never touched)
CONF_FILE=""
# Empty = $INSTALL_DIR/data/folio.db
SQLITE_DB_PATH=""
SERVICE_NAME="folio"
SERVICE_USER="folio"
SERVICE_GROUP="folio"

# Empty = auto-detect from [server] protocol/http_addr/http_port in the ini.
# Your log shows http://127.0.0.1:6060, so this resolves to
# http://127.0.0.1:6060/healthz.json. Set it explicitly only if nginx/TLS
# makes that address wrong.
HEALTH_URL=""
HEALTH_RETRIES="30"
HEALTH_INTERVAL="2"
KEEP_BACKUPS="3"

# Command that writes a SQL dump to stdout. Keep the password out of this file
# and off the command line (where `ps` would expose it) by using a root-only
# defaults file for a DEDICATED, least-privilege backup account:
#   /etc/folio-db.cnf   (root:root, mode 0600)
#     [client]
#     user=foliobackup
#     password=...
#     host=127.0.0.1
#   sudo chown root:root /etc/folio-db.cnf
#   sudo chmod 600 /etc/folio-db.cnf
#
# NEVER put the MySQL root password in a file on this host. folio-update.sh runs
# as OS root, so a leaked root credential means full control of every database,
# not just Folio's. A dedicated account with the grants below is sufficient.
#
# PRIVILEGES: mysqldump needs more than the plain DML rights the app account
# uses. Current mysqldump versions issue FLUSH TABLES for --single-transaction
# (to keep the snapshot consistent), so the dump account needs RELOAD or
# FLUSH_TABLES. --no-tablespaces below avoids the PROCESS requirement, but
# granting PROCESS as well keeps the dump working if that flag is ever dropped.
#   CREATE USER 'foliobackup'@'localhost' IDENTIFIED BY '<password>';
#   GRANT SELECT, SHOW VIEW, TRIGGER, EVENT, LOCK TABLES
#         ON folio.* TO 'foliobackup'@'localhost';
#   GRANT RELOAD, PROCESS ON *.* TO 'foliobackup'@'localhost';
#   FLUSH PRIVILEGES;
# (RELOAD and PROCESS are global-only in MySQL. These grants are NOT related to
# the masking-policy error below. Never "fix" that error with GRANT SELECT ON
# mysql.*: it exposes mysql.user and the rest of the system schema.)
#
# Flags used below:
#   --single-transaction  consistent InnoDB snapshot, does not lock tables
#   --no-tablespaces      skips tablespace metadata
#   --set-gtid-purged=OFF keeps the dump free of SET @@GLOBAL.GTID_PURGED.
#                         On a GTID-enabled server that line is written by
#                         default, and restoring such a dump onto THIS server
#                         fails with "ERROR 1840: @@GLOBAL.GTID_PURGED can only
#                         be set when @@GLOBAL.GTID_EXECUTED is empty" - the
#                         rollback backup would be useless exactly when it is
#                         needed.
# No --routines: Folio has no stored procedures or functions (all tables come
# from the ORM). Note: dropping it does NOT stop the masking-policy probe.
#
# Verify BEFORE running an update (expect exit=0, a non-empty file, and at most
# the harmless masking-policy line in stderr - see below):
#   sudo mysqldump --defaults-extra-file=/etc/folio-db.cnf \
#     --single-transaction --no-tablespaces --set-gtid-purged=OFF \
#     folio 2>/tmp/folio-dump.err >/tmp/folio-dump-test.sql
#   echo "exit=$?"; cat /tmp/folio-dump.err
#   grep -c '^CREATE TABLE' /tmp/folio-dump-test.sql
#
# Leave empty only if you use sqlite3 (the script then copies the .db file).
DB_BACKUP_CMD="mysqldump --defaults-extra-file=/etc/folio-db.cnf --single-transaction --no-tablespaces --set-gtid-purged=OFF folio"
#
# History: mysqldump 8.0.32 / 5.7.41 (Bug#33630199) began issuing
# FLUSH TABLES ... WITH READ LOCK whenever --single-transaction is used, so the
# dumped rows and the recorded GTID set stay consistent. It fires even with
# --set-gtid-purged=OFF, so that flag is NOT a substitute for the grants above.
# Check the client with:  mysqldump --version
# MariaDB's mariadb-dump may reject --no-tablespaces; drop that flag if it
# complains (it has no tablespace metadata to dump).
#
# Masking-policy noise: some mysqldump builds exit 0 after printing
#   mysqldump: Error: 'SELECT command denied ...' when trying to dump masking
#   policies
# even when every application table was dumped (verify with the CREATE TABLE
# count above). Those objects belong to the server, not Folio: the table may
# not even exist. This is expected with the least-privilege account above and
# needs NO extra grants, NO root account and NO ALLOW_PARTIAL_DB_BACKUP.
# folio-update.sh logs it as a note and continues, but still refuses ANY OTHER
# "mysqldump: Error" line. ALLOW_PARTIAL_DB_BACKUP="1" only overrides that
# refusal for those other errors (use with care).
#
# folio-update.sh also verifies the dump content itself: it counts the
# CREATE TABLE statements in the finished file and refuses an empty or
# truncated dump even when the command exited 0 with a clean stderr.
# To additionally compare that count with the LIVE schema, set the optional
# command below (it must print one number; base tables only):
#   DB_TABLE_COUNT_CMD="mysql --defaults-extra-file=/etc/folio-db.cnf \
#       -N -B -e \"SELECT COUNT(*) FROM information_schema.tables \
#       WHERE table_schema='folio' AND table_type='BASE TABLE'\""
# If the dump contains FEWER tables than this number, the update is refused
# (ALLOW_PARTIAL_DB_BACKUP="1" overrides). Leave it unset to skip the
# comparison - the "at least one table" check still runs either way.
#
# Test the whole database step with NO downtime before updating:
#   sudo folio-update.sh --check-db
# It uses the exact same code path as an update and never stops the service.
#
# To deliberately run WITHOUT any DB backup: ALLOW_NO_DB_BACKUP="1"
# (not recommended - this app migrates its schema automatically on startup).

# Optional proxy for reaching GitHub. curl reads these automatically.
# HTTPS_PROXY="http://127.0.0.1:7897"
# HTTP_PROXY="http://127.0.0.1:7897"
# NO_PROXY="127.0.0.1,localhost"
