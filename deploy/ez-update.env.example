# /etc/ez-update.env - config for ez-update.sh
# Install:  sudo install -m 0600 deploy/ez-update.env.example /etc/ez-update.env
# Owner:    root:root, mode 0600 (GITHUB_TOKEN is a secret).
# Requires curl, tar, find, awk, python3 (or jq), systemctl.
# Oracle Linux 10 ships python3 by default; if missing: sudo dnf install -y python3

GITHUB_REPO="JoyfulLL/ezbookkeeping_credit"

# Leave empty for a public repository. For a private repository use a PAT with
# "repo" scope. Never put this token in the repository or in the systemd unit.
GITHUB_TOKEN=""

# Empty (or "latest") = newest Release; or pin e.g. "credit-1.0.1".
RELEASE_TAG=""

# ---- your existing layout, DO NOT change these paths ----------------------
INSTALL_DIR="/opt/ez"
BACKUP_DIR="/opt/ez-backups"
# Empty = $INSTALL_DIR/conf/ezbookkeeping.ini (the REAL config, never touched)
CONF_FILE=""
# Empty = $INSTALL_DIR/data/ezbookkeeping.db
SQLITE_DB_PATH=""
SERVICE_NAME="ezbookkeeping"
SERVICE_USER="ezbookkeeping"
SERVICE_GROUP="ezbookkeeping"

# Empty = auto-detect from [server] protocol/http_addr/http_port in the ini.
# Your log shows http://127.0.0.1:6060, so this resolves to
# http://127.0.0.1:6060/healthz.json. Set it explicitly only if nginx/TLS
# makes that address wrong.
HEALTH_URL=""
HEALTH_RETRIES="30"
HEALTH_INTERVAL="2"
KEEP_BACKUPS="3"

# Command that writes a SQL dump to stdout. Keep the DB password out of this
# file by using a root-only defaults file, e.g. /etc/ezbookkeeping-db.cnf:
#   [client]
#   user=ezbackup
#   password=...
#   host=127.0.0.1
# Then: sudo chmod 600 /etc/ezbookkeeping-db.cnf
#
# PRIVILEGES: mysqldump needs more than the plain DML rights the app account
# uses. Current mysqldump versions issue FLUSH TABLES for --single-transaction
# (to keep the snapshot consistent), so the dump account also needs RELOAD or
# FLUSH_TABLES. Otherwise every update aborts with:
#
#   mysqldump: Couldn't execute 'FLUSH /*!40101 LOCAL */ TABLES': Access denied;
#   you need (at least one of) the RELOAD or FLUSH_TABLES privilege(s) (1227)
#
# Fix, as MySQL root - preferred, a dedicated backup account (read-only):
#   CREATE USER 'ezbackup'@'localhost' IDENTIFIED BY '<password>';
#   GRANT SELECT, SHOW VIEW, TRIGGER, EVENT, LOCK TABLES
#         ON ezbookkeeping.* TO 'ezbackup'@'localhost';
#   GRANT RELOAD, PROCESS ON *.* TO 'ezbackup'@'localhost';
#   FLUSH PRIVILEGES;
# (RELOAD and PROCESS are global-only in MySQL; alternatively point the
# defaults file at root and skip these grants entirely.)
#
# Flags used below:
#   --single-transaction  consistent InnoDB snapshot, does not lock tables
#   --no-tablespaces      skips tablespace metadata, which otherwise needs the
#                         PROCESS privilege
#   --routines            harmless here: this app stores no procedures and has
#                         no triggers, all tables are created by the ORM
#   --set-gtid-purged=OFF keeps the dump free of SET @@GLOBAL.GTID_PURGED.
#                         On a GTID-enabled server that line is written by
#                         default, and restoring such a dump onto THIS server
#                         fails with "ERROR 1840: @@GLOBAL.GTID_PURGED can only
#                         be set when @@GLOBAL.GTID_EXECUTED is empty" - the
#                         rollback backup would be useless exactly when it is
#                         needed. It does NOT avoid the FLUSH TABLES above.
#
# Verify BEFORE running an update (expect exit=0 and a non-empty file):
#   sudo mysqldump --defaults-extra-file=/etc/ezbookkeeping-db.cnf \
#     --single-transaction --no-tablespaces --set-gtid-purged=OFF \
#     ezbookkeeping > /tmp/ez-dump-test.sql
#   echo "exit=$?"; ls -l /tmp/ez-dump-test.sql
#
# Leave empty only if you use sqlite3 (the script then copies the .db file).
DB_BACKUP_CMD="mysqldump --defaults-extra-file=/etc/ezbookkeeping-db.cnf --single-transaction --no-tablespaces --routines --set-gtid-purged=OFF ezbookkeeping"
#
# History: mysqldump 8.0.32 / 5.7.41 (Bug#33630199) began issuing
# FLUSH TABLES ... WITH READ LOCK whenever --single-transaction is used, so the
# dumped rows and the recorded GTID set stay consistent. It fires even with
# --set-gtid-purged=OFF, so that flag is NOT a substitute for the grants above.
# Check the client with:  mysqldump --version
# MariaDB's mariadb-dump may reject --no-tablespaces or --routines; drop
# whichever flag it complains about (it has no tablespace metadata to dump).
#
# Partial dumps: mysqldump may exit 0 *after* printing
#   mysqldump: Error: 'SELECT command denied to user ... for table
#   'column_masking_policy'' when trying to dump masking policies
# Those are the server's own masking-policy objects, not Folio data,
# but the dump is technically incomplete. ez-update.sh refuses such a dump
# unless ALLOW_PARTIAL_DB_BACKUP="1" is set. Look for a skip flag first:
#   mysqldump --help | grep -i mask
# Then verify what actually landed in the dump:
#   zcat /opt/ez-backups/db-*.sql.gz | grep -c '^CREATE TABLE'
#
# To deliberately run WITHOUT any DB backup: ALLOW_NO_DB_BACKUP="1"
# (not recommended - this app migrates its schema automatically on startup).

# Optional proxy for reaching GitHub. curl reads these automatically.
# HTTPS_PROXY="http://127.0.0.1:7897"
# HTTP_PROXY="http://127.0.0.1:7897"
# NO_PROXY="127.0.0.1,localhost"
