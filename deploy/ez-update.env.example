# /etc/ez-update.env - config for ez-update.sh
# Install:  sudo install -m 0600 deploy/ez-update.env.example /etc/ez-update.env
# Owner:    root:root, mode 0600 (GITHUB_TOKEN is a secret).

GITHUB_REPO="JoyfulLL/ezbookkeeping_credit"

# Leave empty for a public repository. For a private repository use a PAT with
# "repo" scope. Never put this token in the repository or in the systemd unit.
GITHUB_TOKEN=""

# Empty (or "latest") = newest Release; or pin e.g. "credit-1.0.1".
RELEASE_TAG=""

# ---- your existing layout, DO NOT change these paths ----------------------
INSTALL_DIR="/opt/ez"
BACKUP_DIR="/opt/ez-backups"
# Empty = $INSTALL_DIR/conf/ezbookkeeping.ini (the REAL config, never touched)
CONF_FILE=""
# Empty = $INSTALL_DIR/data/ezbookkeeping.db
SQLITE_DB_PATH=""
SERVICE_NAME="ezbookkeeping"
SERVICE_USER="ezbookkeeping"
SERVICE_GROUP="ezbookkeeping"

# Empty = auto-detect from [server] protocol/http_addr/http_port in the ini.
# Your log shows http://127.0.0.1:6060, so this resolves to
# http://127.0.0.1:6060/healthz.json. Set it explicitly only if nginx/TLS
# makes that address wrong.
HEALTH_URL=""
HEALTH_RETRIES="30"
HEALTH_INTERVAL="2"
KEEP_BACKUPS="3"

# Command that writes a SQL dump to stdout. Keep the DB password out of this
# file by using a root-only defaults file, e.g. /etc/ezbookkeeping-db.cnf:
#   [client]
#   user=ezbookkeeping
#   password=...
#   host=127.0.0.1
# Then: sudo chmod 600 /etc/ezbookkeeping-db.cnf
# Leave empty only if you use sqlite3 (the script then copies the .db file).
DB_BACKUP_CMD="mysqldump --defaults-extra-file=/etc/ezbookkeeping-db.cnf --single-transaction --routines ezbookkeeping"

# Optional proxy for reaching GitHub. curl reads these automatically.
# HTTPS_PROXY="http://127.0.0.1:7897"
# HTTP_PROXY="http://127.0.0.1:7897"
# NO_PROXY="127.0.0.1,localhost"
